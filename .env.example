# ─────────────────────────────────────────────
#  Meera Prakash Education Center — Environment
#  Copy this file to `.env.local` and fill values.
#  NEVER commit .env.local to git.
# ─────────────────────────────────────────────

# --- Email (admission form → your inbox) ---
# For Gmail: create an "App Password" (Google Account → Security → App passwords)
# and use it here. The plain Gmail login password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=meeraprakasheducation@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
# Where admission leads should be delivered (defaults to SMTP_USER's inbox)
LEADS_TO_EMAIL=meeraprakasheducation@gmail.com

# --- Razorpay (online fee payment) ---
# Get these from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─────────────────────────────────────────────
#  Admission Guru CRM (Supabase)
#  Create a NEW Supabase project for Meera at https://supabase.com
#  (do NOT reuse any other client's project), then copy the values from
#  Project Settings → API.
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
# Service role key — server-side only, NEVER expose in the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Postgres connection string (Project Settings → Database → Connection string)
# Used only by `node scripts/run-migrations.js` to set up the CRM tables.
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-ref.supabase.co:5432/postgres

# Optional: "From" address for CRM emails (salary slips etc.)
SMTP_FROM=Meera Prakash Education Center <meeraprakasheducation@gmail.com>

# Secret for the Vercel cron that auto-punches-out attendance daily
CRON_SECRET=generate_a_random_string_here
