# ─────────────────────────────────────────────
#  Meera Prakash Education Center — Environment
#  Copy this file to `.env.local` and fill values.
#  NEVER commit .env.local to git.
# ─────────────────────────────────────────────

# --- Email (admission form → your inbox) ---
# For Gmail: create an "App Password" (Google Account → Security → App passwords)
# and use it here. The plain Gmail login password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=meeraprakasheducation@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
# Where admission leads should be delivered (defaults to SMTP_USER's inbox)
LEADS_TO_EMAIL=meeraprakasheducation@gmail.com

# --- Razorpay (online fee payment) ---
# Get these from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
